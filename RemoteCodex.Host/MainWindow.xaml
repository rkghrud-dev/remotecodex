<Window x:Class="RemoteCodex.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RemoteCodex Host" Height="760" Width="1120">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#D0D7DE" BorderThickness="1" Padding="12" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="RemoteCodex Host"/>
                    <TextBlock x:Name="ServerStatusText" Margin="0,6,0,0" Text="Server stopped"/>
                    <TextBlock Margin="0,6,0,0" Text="Guest URL: http://HOST_TAILSCALE_IP:7777/remotehub"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="StartButton" Width="120" Height="36" Margin="12,0,0,0" Click="StartButton_Click" Content="Start Host"/>
                <Button Grid.Column="2" x:Name="StopButton" Width="120" Height="36" Margin="8,0,0,0" Click="StopButton_Click" Content="Stop Host" IsEnabled="False"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Connected Guests" Margin="0,0,8,0">
                <ListBox x:Name="GuestsList" DisplayMemberPath="MachineName"/>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Remote Actions" Margin="8,0,0,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Width="140" Height="32" Click="ScreenshotButton_Click" Content="Request Screenshot"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Type text"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TypeTextBox" Margin="8,8,8,0" Height="30"/>
                    <Button Grid.Row="1" Grid.Column="2" Width="90" Height="30" Margin="0,8,0,0" Click="TypeButton_Click" Content="Send"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="PowerShell"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="PowerShellBox" Margin="8,8,8,0" Height="30" Text="Get-Location"/>
                    <Button Grid.Row="2" Grid.Column="2" Width="90" Height="30" Margin="0,8,0,0" Click="PowerShellButton_Click" Content="Run"/>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Screenshot - click image to send a left click" Margin="0,12,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="ScreenshotImage" Stretch="None" MouseLeftButtonDown="ScreenshotImage_MouseLeftButtonDown"/>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Log" Margin="0,12,0,0">
            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </GroupBox>
    </Grid>
</Window>
